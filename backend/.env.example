# Copy to .env and fill in. Never commit .env.
# Create a key at https://developer.clashroyale.com (whitelist your public IP).
CR_API_KEY=your-jwt-here
# Use https://proxy.royaleapi.dev/v1 if you whitelist 45.79.218.79 instead of your own IP.
CR_API_BASE=https://api.clashroyale.com/v1
DEFAULT_PLAYER_TAG=
DATABASE_URL=sqlite:///./data/clash.sqlite
SCHEDULER_ENABLED=true
